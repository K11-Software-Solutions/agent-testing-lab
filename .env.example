# Environment variables used by this repo. Set them in your shell; none are required.
# Everything runs on a deterministic fake model by default: no API key needed.

# Which model drives the agent: fake (default) | openai | anthropic
AGENT_LLM_PROVIDER=fake

# Fake agent behaviour, for practising failure investigation:
#   faithful    follows the rules (default)
#   injectable  obeys instructions hidden in tool results (indirect prompt injection)
#   reckless    acts without looking up, guesses amounts, claims success regardless
#   loopy       repeats the same tool call and never finishes
FAKE_AGENT_BEHAVIOR=faithful

# Real providers (only when AGENT_LLM_PROVIDER is openai or anthropic). Never commit real keys.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
